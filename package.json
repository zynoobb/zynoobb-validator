{
  "name": "@zynoobb/validator",
  "version": "1.0.1",
  "description": "한글과 영어 입력을 위한 검증 라이브러리",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./validators": {
      "require": "./dist/validators/index.js",
      "import": "./dist/validators/index.mjs",
      "types": "./dist/validators/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "npm run build:cjs && npm run build:esm",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "validator",
    "korean",
    "english",
    "validation",
    "input",
    "form",
    "typescript",
    "node",
    "next",
    "nest"
  ],
  "author": "zynoobb <jw9491@gmail.com> (https://github.com/zynoobb)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zynoobb/zyno-validator.git"
  },
  "bugs": {
    "url": "https://github.com/zynoobb/zyno-validator/issues"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.37.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.7",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
